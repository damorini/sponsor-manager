# =============================================================================
# .env per la PRODUZIONE (Docker Compose). Copia in ".env" sul server e compila.
#   cp .env.prod.example .env  &&  nano .env
# NON committare il .env vero (è in .gitignore).
# =============================================================================

# Obbligatori --------------------------------------------------------------
# Chiave segreta lunga e casuale. Generala con:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=

# Domini ammessi, separati da virgola (no http://). Es: valet.it,www.valet.it
ALLOWED_HOSTS=

# Password del database (usata sia da Postgres sia dall'app).
DB_PASSWORD=

# Opzionali ----------------------------------------------------------------
# Traduzione automatica IT->EN (chiave gratuita su deepl.com). Lascia vuoto se non usata.
DEEPL_API_KEY=

# Email reali (di default le email vanno in console). Esempio Postmark/Brevo:
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.postmarkapp.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=True
# DEFAULT_FROM_EMAIL=Sponsor Manager <noreply@valet.it>

# PayPal (per i pagamenti online). 'live' per la produzione.
# PAYPAL_MODE=live
# PAYPAL_CLIENT_ID=
# PAYPAL_CLIENT_SECRET=
# PAYPAL_WEBHOOK_ID=

# URL pubblico del sito (per i link nelle email/PDF). Es: https://valet.it
# SITE_URL=https://valet.it
