# Configurazione Sponsor Manager - copiare in .env e personalizzare
# I valori segnati REQUIRED vanno sempre cambiati. Gli altri hanno default sensati.

# === Django core ===
SECRET_KEY=cambia-questa-chiave-in-produzione-usa-un-valore-lungo-e-casuale
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_SETTINGS_MODULE=config.settings.development

# === Database PostgreSQL === REQUIRED
DB_NAME=sponsor_manager
DB_USER=postgres
DB_PASSWORD=cambia-password
DB_HOST=localhost
DB_PORT=5432

# === Branding (compaiono in email, portale, contratti) ===
ORGANIZER_DISPLAY_NAME=VALET S.r.l.
ORGANIZER_ADDRESS=Via Dei Fornaciai 29/B, 40129 Bologna
SUPPORT_EMAIL=info@valet.it
BRAND_PRIMARY_COLOR=#1f4e79
BRAND_LOGO_URL=
SIGNATURE_PLACE=Bologna

# === URL pubblici ===
SITE_URL=http://localhost:8000
PORTAL_URL=http://localhost:8000/portal/

# === Email (in dev usa console; in prod metti SMTP reale) ===
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=Sponsor Manager <noreply@valet.it>
# In produzione (es. Postmark/Brevo):
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.postmarkapp.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=il-tuo-token
# EMAIL_HOST_PASSWORD=il-tuo-token
# EMAIL_USE_TLS=True

# === Celery (Redis broker) ===
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# === PayPal (lascia sandbox in dev) ===
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_MERCHANT_ID=
