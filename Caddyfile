# Caddy = entrypoint pubblico con HTTPS automatico (Let's Encrypt).
# In produzione metti SITE_ADDRESS=tuodominio.it nel .env: Caddy ottiene e
# rinnova il certificato da solo. In locale, SITE_ADDRESS=localhost usa un
# certificato interno (curl -k).
{$SITE_ADDRESS:localhost} {
	encode zstd gzip

	# File statici e media serviti direttamente da Caddy
	handle_path /static/* {
		root * /app/staticfiles
		file_server
	}
	handle_path /media/* {
		root * /app/media
		file_server
	}

	# Tutto il resto all'app Django (Gunicorn).
	# keepalive off: Gunicorn con worker sync non gestisce bene le connessioni
	# persistenti riusate da Caddy verso l'upstream - un worker occupato su
	# una connessione riusata puo' fraintendere la richiesta successiva e
	# rispondere 400 Bad Request in modo intermittente (~1 volta su 2).
	# Disabilitando il keepalive verso l'upstream, Caddy apre una connessione
	# nuova per ogni richiesta e il problema sparisce.
	reverse_proxy web:8000 {
		transport http {
			keepalive off
		}
	}
}
