# Caddy = entrypoint pubblico con HTTPS automatico (Let's Encrypt).
# In produzione metti SITE_ADDRESS=tuodominio.it nel .env: Caddy ottiene e
# rinnova il certificato da solo. In locale, SITE_ADDRESS=localhost usa un
# certificato interno (curl -k).
{$SITE_ADDRESS:localhost} {
	encode zstd gzip

	# File statici e media serviti direttamente da Caddy
	handle_path /static/* {
		root * /app/staticfiles
		file_server
	}
	handle_path /media/* {
		root * /app/media
		file_server
	}

	# Tutto il resto all'app Django (Gunicorn).
	# Usa il nome CONTAINER esplicito (sponsor_manager_web), non l'alias di
	# rete generico "web": se un altro progetto sulla stessa rete Docker
	# condivisa ha anch'esso un servizio chiamato "web" (es. faculty-manager),
	# il DNS interno di Docker risolve "web" a ENTRAMBI i container e Caddy
	# alterna casualmente tra i due - quando finisce sull'app sbagliata,
	# il suo ALLOWED_HOSTS diverso fa rispondere 400 Bad Request in modo
	# intermittente (~1 volta su 2). Il nome container e' univoco, niente
	# ambiguita' DNS.
	reverse_proxy sponsor_manager_web:8000
}
